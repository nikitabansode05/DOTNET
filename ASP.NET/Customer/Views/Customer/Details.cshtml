@{
    var name="Ravi";
}
<h2>@name</h2>

@if(Model.FirstName=="Nikita"){
    <p>Hie Nikita</p>
}else{
    <p>hieee</p>
}

@for(int i=1;i<=5;i++){
    <h3>@i</h3>
}